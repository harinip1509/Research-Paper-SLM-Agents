# ScholarForge Environment Configuration
# API Keys (Do not commit real keys to version control)
GROQ_API_KEY=
S2_API_KEY=

# Groq Model Configurations (configurable per agent role)
GROQ_MODEL_WRITING=llama-3.3-70b-versatile
GROQ_MODEL_REVIEW=llama-3.3-70b-versatile
GROQ_MODEL_PLANNING=llama-3.3-70b-versatile
GROQ_MODEL_LITERATURE=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Topic Uniqueness Parameters
UNIQUENESS_OVERLAP_THRESHOLD=0.75
TOP_K_PAPERS_RETRIEVAL=10

# Database & Cache
DATABASE_URL=sqlite:///./scholarforge.db
CACHE_EXPIRATION_HOURS=72

# Local Model Serving (Optional / Fallback)
LOCAL_LITERATURE_MODEL_PATH=models/qwen2.5-1.5b-aclsum.gguf
USE_LOCAL_LITERATURE_MODEL=false

# App Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
